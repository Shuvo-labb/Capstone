# Environment variables and config files
backend/config/.env
backend/config/.env.local
config/.env

# Uploaded files and backups
backend/uploads/*
database/backups/*
!database/backups/.gitkeep

# Application logs
logs/*
!logs/.gitkeep

# OS-specific files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE and editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# PHP dependencies (if using Composer later)
vendor/
composer.lock

# Node modules (if adding frontend build tools later)
node_modules/
npm-debug.log

# System files
*.log
.htaccess
